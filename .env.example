VITE_API_BASE_URL=http://localhost:8081
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Docker backend: same Web API key as VITE_FIREBASE_API_KEY (Identity Toolkit password reset)
# FIREBASE_WEB_API_KEY=

# Optional: SMS OTP UI throttling (defaults: 5 min resend cooldown, 5 failures → 5 min lockout)
# VITE_OTP_RESEND_COOLDOWN_MS=300000
# VITE_OTP_MAX_VERIFY_FAILURES=5
# VITE_OTP_VERIFY_LOCKOUT_MS=300000

# Salon time zone (IANA); must match the backend SALON_TIMEZONE. Default Asia/Kolkata.
# VITE_SALON_TIMEZONE=Asia/Kolkata
